{
  "name": "codex-motion-studio",
  "version": "1.0.0",
  "description": "Seu audio e seu prompt viram motion graphics dentro do Codex, com Astra e Remotion.",
  "repository": {"type": "git", "url": "https://github.com/eltomachado/codex-motion-studio.git"},
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@remotion/bundler": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "ingest": "node scripts/ingest.mjs",
    "validate": "node scripts/validate.mjs",
    "render": "node scripts/render.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && node --test tests/*.test.mjs"
  },
  "allowScripts": {
    "esbuild": true,
    "ffmpeg-static": true,
    "onnxruntime-node": true,
    "protobufjs": false
  },
  "overrides": {"zod": "4.6.6"}
}
